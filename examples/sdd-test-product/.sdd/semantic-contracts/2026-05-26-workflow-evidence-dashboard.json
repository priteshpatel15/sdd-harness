    },
    {
      "id": "ARCH-003",
      "statement": "SQLite and JSONL telemetry are replaceable adapters.",
      "verificationMethod": "static-rule"
    },
    {
      "id": "ARCH-004",
      "statement": "HTTP and React interfaces delegate to application use cases instead of owning business rules.",
      "verificationMethod": "static-rule"
    },
