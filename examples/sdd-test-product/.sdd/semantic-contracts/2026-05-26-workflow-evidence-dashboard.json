      "title": "FLOW-001 Operator creates evidence",
      "actorIds": [
        "ACT-001"
      ],
      "preconditions": [],
      "steps": [
        "open /evidence",
        "submit valid title category and status",
        "repository inserts one EvidenceRecord in the isolated SQLite test database",
        "UI shows success and the new row",
        "telemetry records evidence_create_started and evidence_create_succeeded"
      ],
      "expectedVisibleOutcome": "FLOW-001 Operator creates evidence",
      "expectedDataMutations": [
        "FLOW-001 inserts one evidence record into the isolated SQLite evidence table.",
        "FLOW-002 performs no database mutation.",
        "FLOW-003 seeds representative evidence rows in the isolated SQLite test database before read-only inspection.",
        "FLOW-004 rejects the attempted insert and persists no new evidence row."
